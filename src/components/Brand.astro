---
/*
 * The Beaver Games brand mark.
 *
 * Two lockups from the same artwork:
 *
 *   header  the cropped mascot badge beside real CSS type. The full logo has
 *           "BEAVER GAMES" baked into a square image, so at header height the
 *           lettering is decorative rather than readable — a small crisp badge
 *           plus actual text beats a shrunken picture of text.
 *   footer  the full logo, which has the room to be itself.
 *
 * Each falls back: mark -> full logo -> a CSS mark in the same palette. The check
 * is at build time (Astro components run in Node), so dropping a file into
 * public/media/ is the whole job — no 404 for artwork that is not there yet, and
 * no inline error handler, which the CSP would refuse.
 *
 * NO INLINE STYLES. The site ships `style-src 'self'` with no `unsafe-inline`, so
 * a style attribute is silently refused and logs a violation on every page load.
 * Sizes are classes in global.css. The width/height attributes stay because they
 * are HTML, not CSS, and they let the browser reserve the aspect ratio.
 */
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  variant?: 'header' | 'footer';
}

const { variant = 'header' } = Astro.props;

// WebP first: the PNG logo is the 1.4 MB master, not something to ship in a footer.
const MARKS = ['beaver-games-mark.webp', 'beaver-games-mark.png', 'beaver-games-mark.svg'];
const FULL = ['beaver-games-logo.webp', 'beaver-games-logo.png', 'beaver-games-logo.svg', 'logo.png', 'logo.svg'];

const mediaDir = join(process.cwd(), 'public', 'media');
const find = (names) => names.find((f) => existsSync(join(mediaDir, f)));

// The header prefers the badge; the footer prefers the whole thing.
const chosen = variant === 'header' ? find(MARKS) || find(FULL) : find(FULL) || find(MARKS);
const src = chosen ? `/media/${chosen}` : null;

/* The picture's own size, read from its header, so the browser can reserve the
   space before the file arrives and nothing beside the logo jumps. */
function sizeOf(file) {
  try {
    const b = readFileSync(file);
    if (b.toString('latin1', 1, 4) === 'PNG') return [b.readUInt32BE(16), b.readUInt32BE(20)];
    if (b.toString('latin1', 8, 12) !== 'WEBP') return null;
    const kind = b.toString('latin1', 12, 16);
    if (kind === 'VP8X') return [1 + b.readUIntLE(24, 3), 1 + b.readUIntLE(27, 3)];
    if (kind === 'VP8L') {
      const n = b.readUInt32LE(21);
      return [1 + (n & 0x3fff), 1 + ((n >> 14) & 0x3fff)];
    }
    if (kind === 'VP8 ') return [b.readUInt16LE(26) & 0x3fff, b.readUInt16LE(28) & 0x3fff];
  } catch {}
  return null;
}
const size = chosen ? sizeOf(join(mediaDir, chosen)) : null;
// Show type beside the image only when the image is the wordmark-free badge.
const withType = variant === 'header' && !!chosen && MARKS.includes(chosen);
---

{
  src ? (
    <>
      <img
        src={src}
        alt="Beaver Games"
        class={`brand-logo brand-logo-${variant}`}
        width={size?.[0]}
        height={size?.[1]}
        decoding="async"
        loading={variant === 'footer' ? 'lazy' : undefined}
      />
      {withType && <span class="brand-name">BEAVER GAMES</span>}
    </>
  ) : (
    <span class={`brand-fallback brand-fallback-${variant}`}>
      <span class="brand-mark">B</span>
      <span class="brand-name">BEAVER GAMES</span>
    </span>
  )
}
