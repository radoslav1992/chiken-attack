---
/*
 * The Beaver Games brand mark.
 *
 * If a logo image has been dropped into public/media/ it is used; otherwise this
 * falls back to a CSS mark drawn in the same palette. The check happens at build
 * time — Astro components run in Node — so adding the file is the whole job:
 * drop it in, rebuild, and every header and footer picks it up with no code
 * change. No 404 in the meantime, and no inline error handler, which the site's
 * CSP would block anyway.
 *
 * NO INLINE STYLES. The site ships `style-src 'self'` with no `unsafe-inline`, so
 * a `style="height:64px"` attribute is silently refused and logs a CSP violation
 * on every page load. Sizes are therefore classes in global.css, not props baked
 * into markup. The `height`/`width` attributes stay because they are HTML, not
 * CSS, and they give the browser an aspect ratio to reserve before the image
 * loads.
 *
 * Accepted names, first match wins, so whichever form you have works.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** Which size class to use. Heights live in global.css. */
  variant?: 'header' | 'footer';
  /** Hide the wordmark when the logo image already contains one. */
  wordmark?: boolean;
}

const { variant = 'header', wordmark = true } = Astro.props;

const CANDIDATES = [
  'beaver-games-logo.png',
  'beaver-games-logo.webp',
  'beaver-games-logo.svg',
  'logo.png',
  'logo.svg',
];

const mediaDir = join(process.cwd(), 'public', 'media');
const found = CANDIDATES.find((f) => existsSync(join(mediaDir, f)));
const logo = found ? `/media/${found}` : null;
---

{
  logo ? (
    <img
      src={logo}
      alt="Beaver Games"
      width="1024"
      height="1024"
      class={`brand-logo brand-logo-${variant}`}
      decoding="async"
    />
  ) : (
    <span class={`brand-fallback brand-fallback-${variant}`}>
      <span class="brand-mark">B</span>
      {wordmark && <span class="brand-name">BEAVER GAMES</span>}
    </span>
  )
}
