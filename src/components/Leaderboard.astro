---
/*
 * Live leaderboard, filled client-side from GET /api/scores. Rendered with an
 * empty-state row so the page is complete even if the API is unreachable
 * (static build, no data at build time).
 */
interface Props {
  game: string;
  limit?: number;
  period?: "week" | "all";
  compact?: boolean;
}

const { game, limit = 8, period = "week", compact = false } = Astro.props;
---

<div
  class="board"
  data-board
  data-game={game}
  data-limit={String(limit)}
  data-period={period}
  data-difficulty="veteran"
>
  <div class="board-head">
    <span>RANK</span>
    <span>PLAYER</span>
    <span>SCORE</span>
  </div>
  <div data-board-rows>
    <div class="board-empty" data-board-empty>
      {compact
        ? "No scores yet — set the first one."
        : "No scores on the board yet. Play a round and put your name up first."}
    </div>
  </div>
</div>

<script>
  for (const board of document.querySelectorAll<HTMLElement>("[data-board]")) {
    const rows = board.querySelector<HTMLElement>("[data-board-rows]");
    if (!rows) continue;
    let requestId = 0;
    async function load() {
      const id = ++requestId;
      const params = new URLSearchParams({
        game: board.dataset.game || "",
        limit: board.dataset.limit || "8",
        period: board.dataset.period || "week",
        difficulty: board.dataset.difficulty || "veteran",
      });
      rows!.textContent = "";
      const note = document.createElement("div");
      note.className = "board-empty";
      note.textContent = "Loading the board…";
      rows!.append(note);
      try {
        const response = await fetch(`/api/scores?${params}`);
        if (!response.ok) throw new Error();
        const data = await response.json();
        if (id !== requestId) return;
        if (!Array.isArray(data.scores)) throw new Error();
        if (!data.scores.length) {
          note.textContent = "No scores yet. Set the first one.";
          return;
        }
        rows!.textContent = "";
        data.scores.forEach(
          (row: { name: string; score: number }, i: number) => {
            const div = document.createElement("div");
            div.className = "board-row" + (i === 0 ? " is-first" : "");
            for (const [cls, value] of [
              ["board-rank", String(i + 1).padStart(2, "0")],
              ["board-name", row.name],
              ["board-score", row.score.toLocaleString("en-US")],
            ]) {
              const span = document.createElement("span");
              span.className = cls;
              span.textContent = value;
              div.append(span);
            }
            rows!.append(div);
          },
        );
      } catch {
        if (id !== requestId) return;
        note.textContent =
          "The community board is unavailable. You can still play and save personal bests.";
        note.classList.add("board-error");
        const retry = document.createElement("button");
        retry.type = "button";
        retry.className = "tool-btn";
        retry.textContent = "Try again";
        retry.addEventListener("click", load);
        note.append(document.createElement("br"), retry);
      }
    }
    load();
    window.addEventListener("arcade:refresh-board", load);
  }
</script>
