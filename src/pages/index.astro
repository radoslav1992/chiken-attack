---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Leaderboard from "../components/Leaderboard.astro";
import { GAMES, PLAYABLE } from "../data/games.js";
import { FAQ } from "../data/faq.js";
import { SITE } from "../data/site.js";

const featured = PLAYABLE[0];
const genres = ["All", ...new Set(PLAYABLE.map((g) => g.genre))];

const orgId = new URL("/#organization", Astro.site).href;
const schema = [
  {
    "@type": "ItemList",
    name: `${SITE.name} arcade`,
    itemListElement: PLAYABLE.map((g, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "VideoGame",
        name: g.title,
        url: new URL(`/games/${g.slug}/`, Astro.site).href,
        image: new URL(g.art, Astro.site).href,
        description: g.blurb,
        genre: g.genre,
        gamePlatform: "Web browser",
        operatingSystem: "Any",
        playMode: "SinglePlayer",
        applicationCategory: "Game",
        datePublished: g.meta.releasedISO,
        author: { "@id": orgId },
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
        },
      },
    })),
  },
  {
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title="Beaver Games — small games. Big rematch energy." schema={schema}>
  <div id="top"></div>
  <Header />
  <main id="main" class="arcade-home">
    <section class="wrap lobby" aria-labelledby="lobby-title">
      <div class="lobby-heading">
        <div>
          <p class="eyebrow">YOUR FIVE-MINUTE ESCAPE</p>
          <h1 id="lobby-title">
            Small games.
            <br />
            <span>Big rematch energy.</span>
          </h1>
        </div>
        <p class="lobby-note">
          Four little worlds. Zero downloads.
          <br />
          Pick your next obsession.
        </p>
      </div>
      <div class="lobby-features">
        <a href="/games/chicken-attack/?play=1" class="feature-game">
          <img
            src={featured.stageArt}
            alt="Chicken Attack space shooter"
            width="1200"
            height="700"
            fetchpriority="high"
          />
          <div class="feature-shade"></div>
          <span class="feature-tag">THE COOP HAS GONE ROGUE</span>
          <div class="feature-copy">
            <span class="eyebrow">SHOOTER · 9 WEAPONS · BOSS BATTLES</span>
            <h2>
              Chicken
              <br />
              Attack
            </h2>
            <p>
              Space poultry. Serious firepower.
              <br />
              How long can you hold the line?
            </p>
            <span class="arcade-cta">
              Play now <span aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
        <aside class="daily-pick" data-daily-pick>
          <div class="daily-top">
            <span class="eyebrow">TODAY’S PICK</span>
            <span aria-hidden="true">✳</span>
          </div>
          <img
            src={PLAYABLE[1].art}
            alt=""
            width="480"
            height="300"
            data-daily-art
          />
          <div class="daily-copy">
            <p class="eyebrow" data-daily-genre>
              ONE MORE RUN?
            </p>
            <h2 data-daily-title>Beaver Dash</h2>
            <p data-daily-copy>
              Tap, double jump, and try not to become driftwood.
            </p>
            <a
              href="/games/beaver-dash/?play=1"
              class="daily-link"
              data-daily-link
            >
              Take a break. Play a round. ↗
            </a>
          </div>
        </aside>
      </div>
      <div class="lobby-perks">
        <span>↗ Instant browser play</span>
        <span>◉ No account needed</span>
        <span>♡ No ads</span>
        <span>⌁ Touch + keyboard</span>
      </div>
    </section>
    <section id="catalog" class="wrap arcade-catalog">
      <div class="catalog-head">
        <div>
          <p class="eyebrow">PICK YOUR NEXT “LAST ROUND”</p>
          <h2 class="h2">
            The arcade <span class="game-count">04</span>
          </h2>
        </div>
        <button class="surprise-btn" data-surprise type="button">
          ⤨ Surprise me
        </button>
      </div>
      <div class="catalog-controls">
        <div class="genre-filters" data-genre-filters>
          {genres.map((g, i) => (
            <button
              type="button"
              class="genre-btn"
              data-genre={g}
              aria-pressed={String(i === 0)}
            >
              {g}
            </button>
          ))}
          <button
            type="button"
            class="genre-btn"
            data-genre="Saved"
            aria-pressed="false"
          >
            ♡ Saved
          </button>
        </div>
        <label class="game-search">
          <span aria-hidden="true">⌕</span>
          <input
            type="search"
            placeholder="Find your game"
            aria-label="Find your game"
            data-search
          />
        </label>
      </div>
      <div class="arcade-grid" data-game-grid>
        {PLAYABLE.map((g, i) => (
          <article
            class={`arcade-card cabinet-${i}`}
            data-genre={g.genre}
            data-slug={g.slug}
            data-title={g.title.toLowerCase()}
          >
            <a href={`/games/${g.slug}/?play=1`} class="arcade-card-art">
              <img
                src={g.art}
                alt={`${g.title} game art`}
                width="600"
                height="380"
                loading="lazy"
              />
              <span class="card-play">▶ Play</span>
            </a>
            <div class="arcade-card-info">
              <div class="card-meta">
                <span>{g.genre}</span>
                <span>{g.stats.runTime}</span>
              </div>
              <div class="arcade-card-title">
                <h3>
                  <a href={`/games/${g.slug}/?play=1`}>{g.title}</a>
                </h3>
                <button
                  type="button"
                  class="save-game"
                  data-save={g.slug}
                  aria-label={`Save ${g.title}`}
                  aria-pressed="false"
                >
                  ♡
                </button>
              </div>
              <p>{g.blurb}</p>
              <span class="personal-best" data-best={g.slug}>
                Your next high score starts here.
              </span>
            </div>
          </article>
        ))}
      </div>
      <p class="catalog-empty" data-empty hidden>
        No games here yet. Try another filter or save a favourite with the
        heart.
      </p>
      <p class="catalog-foot">
        All games are free. Your favourites and personal bests stay on this
        device.
      </p>
    </section>
    <section id="leaderboard" class="wrap rematch-section">
      <div class="rematch-copy">
        <span class="eyebrow">A LITTLE FRIENDLY COMPETITION</span>
        <h2>
          Good score?
          <br />
          <span>Make it personal.</span>
        </h2>
        <p>
          Finish a run. Share your score challenge. Give a friend something to
          beat.
        </p>
        <a href="/games/chicken-attack/?play=1" class="arcade-cta">
          Set the score ↗
        </a>
        <p class="board-disclaimer">
          Community scores are player-submitted. Weekly boards start Monday,
          00:00 UTC.
        </p>
      </div>
      <div class="lobby-board">
        <div class="board-caption">
          <h3>Chicken Attack</h3>
          <span>This week · Veteran</span>
        </div>
        <Leaderboard game="chicken-attack" limit={5} period="week" />
      </div>
    </section>
    <section id="faq" class="wrap section">
      <div class="kicker-row">
        <span class="eyebrow">BEFORE YOUR NEXT ROUND</span>
      </div>
      <h2 class="h2">Good to know.</h2>
      <div class="faq-list">
        {FAQ.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">
              <h3>{item.q}</h3>
              <span class="faq-toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
    <section id="signup" class="signup">
      <div class="signup-inner">
        <span class="kicker is-red">NEW CABINET WHEN IT'S READY</span>
        <h2 class="signup-title">GET THE DROP FIRST</h2>
        <p class="signup-copy">
          Leave an email and hear about new cabinets when they land. Nothing
          else, ever.
        </p>
        <form class="signup-form" data-signup novalidate>
          <label class="hp-field" aria-hidden="true">
            Leave this empty
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </label>
          <input
            class="signup-input"
            type="email"
            name="email"
            placeholder="you@example.com"
            required
            aria-label="Email address"
          />
          <button type="submit" class="signup-btn">
            SIGN ME UP
          </button>
        </form>
        <p class="signup-note" data-signup-note></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<script>
  import { PLAYABLE } from "../data/games.js";
  const getSaved = (): string[] => {
    try {
      const v = JSON.parse(localStorage.getItem("beaver-games.favs") || "[]");
      return Array.isArray(v) ? v.filter((x) => typeof x === "string") : [];
    } catch {
      return [];
    }
  };
  let saved = getSaved();
  let genre = "All";
  let query = "";
  const cards = [
    ...document.querySelectorAll<HTMLElement>("[data-game-grid] article"),
  ];
  function filterGames() {
    let count = 0;
    for (const card of cards) {
      const match =
        (genre === "All" ||
          (genre === "Saved"
            ? saved.includes(card.dataset.slug || "")
            : card.dataset.genre === genre)) &&
        (card.dataset.title || "").includes(query);
      card.hidden = !match;
      if (match) count++;
    }
    const empty = document.querySelector<HTMLElement>("[data-empty]");
    if (empty) empty.hidden = count > 0;
  }
  function paintSaved() {
    document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((b) => {
      const on = saved.includes(b.dataset.save || "");
      b.setAttribute("aria-pressed", String(on));
      b.textContent = on ? "♥" : "♡";
    });
    filterGames();
  }
  document
    .querySelector("[data-genre-filters]")
    ?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-genre]",
      );
      if (!btn) return;
      genre = btn.dataset.genre || "All";
      document
        .querySelectorAll("[data-genre-filters] button")
        .forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      filterGames();
    });
  document
    .querySelector<HTMLInputElement>("[data-search]")
    ?.addEventListener("input", (e) => {
      query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      filterGames();
    });
  document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((b) =>
    b.addEventListener("click", () => {
      const slug = b.dataset.save!;
      saved = saved.includes(slug)
        ? saved.filter((s) => s !== slug)
        : [...saved, slug];
      try {
        localStorage.setItem("beaver-games.favs", JSON.stringify(saved));
      } catch {}
      paintSaved();
    }),
  );
  paintSaved();
  document.querySelector("[data-surprise]")?.addEventListener("click", () => {
    location.href = `/games/${PLAYABLE[Math.floor(Math.random() * PLAYABLE.length)].slug}/?play=1`;
  });
  const pick = PLAYABLE[Math.floor(Date.now() / 86400000) % PLAYABLE.length];
  const art = document.querySelector<HTMLImageElement>("[data-daily-art]");
  if (art) art.src = pick.art;
  const title = document.querySelector("[data-daily-title]");
  if (title) title.textContent = pick.title;
  const desc = document.querySelector("[data-daily-copy]");
  if (desc) desc.textContent = pick.blurb;
  const link = document.querySelector<HTMLAnchorElement>("[data-daily-link]");
  if (link) link.href = `/games/${pick.slug}/?play=1`;
  const label = document.querySelector("[data-daily-genre]");
  if (label) label.textContent = pick.genre;
  try {
    const records = JSON.parse(
      localStorage.getItem("beaver-games.records") || "{}",
    );
    document.querySelectorAll<HTMLElement>("[data-best]").forEach((el) => {
      const score = records?.[el.dataset.best!]?.score;
      if (Number.isFinite(score) && score > 0)
        el.textContent = `Personal best: ${score.toLocaleString()} pts`;
    });
  } catch {}
  /* Newsletter signup -> POST /api/signup. */
  const form = document.querySelector<HTMLFormElement>("[data-signup]");
  const note = document.querySelector<HTMLElement>("[data-signup-note]");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!note) return;
    const data = new FormData(form);
    const email = String(data.get("email") || "").trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      note.textContent = "That email does not look right.";
      note.className = "signup-note is-err";
      return;
    }
    try {
      const res = await fetch("/api/signup", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          email,
          website: String(data.get("website") || ""),
        }),
      });
      if (!res.ok) throw new Error(String(res.status));
      note.textContent = "You are on the list. See you on drop day.";
      note.className = "signup-note is-ok";
      form.reset();
    } catch {
      note.textContent = "Could not sign you up right now — try again later.";
      note.className = "signup-note is-err";
    }
  });
</script>
