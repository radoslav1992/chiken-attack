# The Coop Arcade — response headers (Workers static assets / Pages).
#
# Cache policy: no filenames are content-hashed, so HTML, scripts and styles
# always revalidate; only icons get a long TTL. Offline play comes from each
# game's service worker, not from browser cache lifetimes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'self'

# Service workers must never be cached, or updates can never land. The root
# one is the self-destruct stub for pre-arcade installs.
/sw.js
  Cache-Control: no-cache, must-revalidate

/chicken-attack/sw.js
  Cache-Control: no-cache, must-revalidate

# Hub
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/404.html
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Chicken Attack
/chicken-attack/
  Cache-Control: no-cache, must-revalidate

/chicken-attack/index.html
  Cache-Control: no-cache, must-revalidate

/chicken-attack/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/chicken-attack/js/*
  Cache-Control: public, max-age=0, must-revalidate

/chicken-attack/css/*
  Cache-Control: public, max-age=0, must-revalidate

/chicken-attack/icons/*
  Cache-Control: public, max-age=604800
