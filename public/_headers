# Beaver Games — response headers (Workers static assets).
#
# Astro assets under /_astro/ are content-hashed and safe to cache forever.
# Everything else revalidates; offline play comes from each game's service
# worker, not from browser cache lifetimes. API responses set their own
# headers in the Worker.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800

# Crawler-facing files: cacheable, but short enough that edits land same-day.
/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# Service workers must never be cached, or updates can never land. The root
# one is the self-destruct stub for older installs.
/sw.js
  Cache-Control: no-cache, must-revalidate

/chicken-attack/sw.js
  Cache-Control: no-cache, must-revalidate

/beaver-dash/sw.js
  Cache-Control: no-cache, must-revalidate

/orbit-cadet/sw.js
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/404.html
  Cache-Control: no-cache, must-revalidate

/games/*
  Cache-Control: no-cache, must-revalidate

# Chicken Attack (not content-hashed: always revalidate, icons long-lived)
/chicken-attack/
  Cache-Control: no-cache, must-revalidate

/chicken-attack/index.html
  Cache-Control: no-cache, must-revalidate

/chicken-attack/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/chicken-attack/js/*
  Cache-Control: public, max-age=0, must-revalidate

/chicken-attack/css/*
  Cache-Control: public, max-age=0, must-revalidate

/chicken-attack/icons/*
  Cache-Control: public, max-age=604800

# Beaver Dash
/beaver-dash/
  Cache-Control: no-cache, must-revalidate

/beaver-dash/index.html
  Cache-Control: no-cache, must-revalidate

/beaver-dash/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/beaver-dash/js/*
  Cache-Control: public, max-age=0, must-revalidate

/beaver-dash/css/*
  Cache-Control: public, max-age=0, must-revalidate

/beaver-dash/icons/*
  Cache-Control: public, max-age=604800

# Orbit Cadet
/orbit-cadet/
  Cache-Control: no-cache, must-revalidate

/orbit-cadet/index.html
  Cache-Control: no-cache, must-revalidate

/orbit-cadet/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/orbit-cadet/js/*
  Cache-Control: public, max-age=0, must-revalidate

/orbit-cadet/css/*
  Cache-Control: public, max-age=0, must-revalidate

/orbit-cadet/icons/*
  Cache-Control: public, max-age=604800

/shared/*
  Cache-Control: public, max-age=0, must-revalidate

/whittle-wares/sw.js
  Cache-Control: no-cache, must-revalidate

/whittle-wares/
  Cache-Control: no-cache, must-revalidate

/whittle-wares/js/*
  Cache-Control: public, max-age=0, must-revalidate

/whittle-wares/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Timber Tails
/timber-tails/sw.js
  Cache-Control: no-cache, must-revalidate

/timber-tails/
  Cache-Control: no-cache, must-revalidate

/timber-tails/index.html
  Cache-Control: no-cache, must-revalidate

/timber-tails/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/timber-tails/js/*
