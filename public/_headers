/timber-tails/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Freedoom. The engine is WebAssembly, which is why the policy at the top of
# this file carries 'wasm-unsafe-eval': it permits compiling a .wasm file and
# nothing else (no eval, no inline script).
/freedoom/sw.js
  Cache-Control: no-cache, must-revalidate

/freedoom/
  Cache-Control: no-cache, must-revalidate

/freedoom/index.html
  Cache-Control: no-cache, must-revalidate

/freedoom/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/freedoom/js/*
  Cache-Control: public, max-age=0, must-revalidate

/freedoom/css/*
  Cache-Control: public, max-age=0, must-revalidate

/freedoom/engine/*
  Cache-Control: public, max-age=0, must-revalidate

# The list of packs: small, and it must be fresh, since it names the packs.
/freedoom/packs.json
  Cache-Control: public, max-age=0, must-revalidate

# The packs themselves. Each file is named after a hash of its contents, so
# a changed pack is a new URL and these can be kept for a long time.
/freedoom/data/*
  Cache-Control: public, max-age=31536000, immutable
