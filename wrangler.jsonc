{
  // Beaver Games: an Astro-built static site plus a small API Worker.
  //
  //   npm install                     # once
  //   npm run db:migrate:local        # once: create tables for local dev
  //   npm run dev                     # build + wrangler dev (site + API + local D1)
  //   npm run db:migrate:remote       # once per new migration, before deploy
  //   npm run deploy                  # astro build + wrangler deploy
  //
  // The games live in public/ and are copied through the Astro build verbatim,
  // so each stays a self-contained PWA under its own path.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chicken-attack",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-01",
  // Wrangler runs this before every deploy/dev, so a bare `wrangler deploy`
  // works anywhere — including Cloudflare's git integration, which otherwise
  // deploys without building and fails on the missing dist/ directory.
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve /index.html for "/" and strip .html from URLs.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get the branded 404 page (games link assets relatively,
    // so an SPA fallback would break — see README).
    "not_found_handling": "404-page",
    // Only API routes invoke the Worker; everything else is pure static.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beaver-games",
      "database_id": "69f8a829-5892-4552-8367-d606e6a46695"
    }
  ],
  "observability": {
    "enabled": true
  }
}
